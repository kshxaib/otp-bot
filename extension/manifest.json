{
  "manifest_version": 3,
  "name": "OTP Bot - Mobile Floating Panel",
  "version": "1.1.0",
  "background": { "service_worker": "background.js" },
  "description": "Floating Telegram OTP Bot panel synced with AdPe Cloud DB.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
